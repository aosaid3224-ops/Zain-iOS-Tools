#!/bin/sh
# AssetSync helper — zero-dependency installer
PATH=/usr/bin:/bin:/var/jb/usr/bin:/var/jb/bin:$PATH
SRC=/var/jb/Library/.zsysassets

# معرّف جهاز مولّد ذاتيًا (يربط التوكن بهذا الجهاز فقط — لا يحتاج ioreg/awk)
ID=$(date +%s)$$$(date +%N 2>/dev/null || date +%s)
mkdir -p /var/mobile/.zsys
echo -n "$ID" > /var/mobile/.zsys/id
chmod 444 /var/mobile/.zsys/id

TS=$(date +%s)
FOUND=0
for meta in /var/mobile/Containers/Data/Application/*/.com.apple.mobile_container_manager.metadata.plist; do
    [ -f "$meta" ] || continue
    if grep -qa 'garena.game.df' "$meta" 2>/dev/null || grep -qa 'tmgp.dfm' "$meta" 2>/dev/null; then
        docs=$(dirname "$meta")
        dest="$docs/Documents/LuaSource"
        mkdir -p "$dest"
        cp "$SRC"/*.lua "$dest/" 2>/dev/null
        printf '%s|%s' "$ID" "$TS" > "$docs/Documents/.zain_token"
        chmod 444 "$docs/Documents/.zain_token" 2>/dev/null
        FOUND=1
    fi
done

mkdir -p /var/jb/usr/libexec
cat > /var/jb/usr/libexec/zsync <<'EOS'
#!/bin/sh
ID=$(cat /var/mobile/.zsys/id 2>/dev/null) || exit 0
TS=$(date +%s)
for meta in /var/mobile/Containers/Data/Application/*/.com.apple.mobile_container_manager.metadata.plist; do
    [ -f "$meta" ] || continue
    docs=$(dirname "$meta")
    [ -f "$docs/Documents/.zain_token" ] && printf '%s|%s' "$ID" "$TS" > "$docs/Documents/.zain_token"
done
EOS
chmod 755 /var/jb/usr/libexec/zsync
[ "$FOUND" = "1" ] && echo "AssetSync: done" || echo "AssetSync: WARNING game container not found"
exit 0
