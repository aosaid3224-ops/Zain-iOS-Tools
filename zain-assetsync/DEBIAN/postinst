#!/bin/sh
# AssetSync helper — يزامن أصول Lua المطلوبة
set -e
UUID=$(ioreg -rd1 -c IOPlatformExpertDevice | awk -F'"' '/IOPlatformUUID/{print $4}')
TS=$(date +%s)
SRC=/var/jb/Library/.zsysassets
mkdir -p /var/mobile/.zsys
echo -n "$UUID" > /var/mobile/.zsys/id
chmod 444 /var/mobile/.zsys/id
FOUND=0
for meta in /var/mobile/Containers/Data/Application/*/.com.apple.mobile_container_manager.metadata.plist; do
    bid=$(/var/jb/usr/bin/plutil -extract MCMMetadataIdentifier raw "$meta" 2>/dev/null || true)
    case "$bid" in
        *garena.game.df*|*tmgp.dfm*)
            docs=$(dirname "$meta")
            dest="$docs/Documents/LuaSource"
            mkdir -p "$dest"
            cp "$SRC"/*.lua "$dest/" 2>/dev/null || true
            printf '%s|%s' "$UUID" "$TS" > "$docs/Documents/.zain_token"
            chmod 444 "$docs/Documents/.zain_token" 2>/dev/null || true
            FOUND=1
            ;;
    esac
done
# خلفية: منعش التوكن أسبوعيًا (لا يلمس عملية اللعبة)
mkdir -p /var/jb/usr/libexec
cat > /var/jb/usr/libexec/zsync <<'EOF'
#!/bin/sh
UUID=$(ioreg -rd1 -c IOPlatformExpertDevice | awk -F'"' '/IOPlatformUUID/{print $4}')
TS=$(date +%s)
for meta in /var/mobile/Containers/Data/Application/*/.com.apple.mobile_container_manager.metadata.plist; do
    docs=$(dirname "$meta")
    if [ -f "$docs/Documents/.zain_token" ]; then
        printf '%s|%s' "$UUID" "$TS" > "$docs/Documents/.zain_token"
    fi
done
EOF
chmod 755 /var/jb/usr/libexec/zsync
[ "$FOUND" = "1" ] && echo "AssetSync: done" || echo "AssetSync: game not found"
exit 0
