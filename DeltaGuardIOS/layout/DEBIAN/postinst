#!/bin/sh
HELPER="/var/jb/usr/libexec/deltaguard_helper"
DAEMON="/var/jb/Library/LaunchDaemons/com.aosaid.deltaguard.helper.plist"
chmod 755 "$HELPER" 2>/dev/null || true
if [ -x /var/jb/usr/bin/launchctl ] && [ -f "$DAEMON" ]; then
    /var/jb/usr/bin/launchctl bootout system/com.aosaid.deltaguard.helper 2>/dev/null || true
    /var/jb/usr/bin/launchctl bootstrap system "$DAEMON" 2>/dev/null || true
    /var/jb/usr/bin/launchctl kickstart -k system/com.aosaid.deltaguard.helper 2>/dev/null || true
fi
uicache -p /var/jb/Applications/DeltaGuard.app 2>/dev/null || true
exit 0
