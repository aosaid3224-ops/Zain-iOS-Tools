#!/bin/bash
set -e

HELPER="/usr/bin/ipainstallerpro_helper"

shopt -s nullglob
for stage_root in "/Applications" "/var/tmp/IPAInstallerPro-Staging"; do
    [ -d "$stage_root" ] || continue
    for stage_path in "$stage_root"/*.app.ipa-stage-*; do
        [ -d "$stage_path" ] || continue
        rm -rf -- "$stage_path" 2>/dev/null || true
    done
done

if [ ! -f "$HELPER" ]; then
    echo "ERROR: $HELPER not found inside the jailbreak root"
    exit 1
fi

echo "Setting setuid root on ${HELPER}..."
chown root:wheel "$HELPER"
chmod 4755 "$HELPER"

if [ -u "$HELPER" ]; then
    echo "✅ Helper setuid verified at ${HELPER}"
else
    echo "❌ FAILED: Could not set setuid bit on ${HELPER}"
    exit 1
fi

if [ -x "$HELPER" ]; then
    echo "✅ Helper is executable"
else
    echo "❌ Helper is not executable"
    exit 1
fi

echo "IPA Installer Pro helper installed successfully"
exit 0
