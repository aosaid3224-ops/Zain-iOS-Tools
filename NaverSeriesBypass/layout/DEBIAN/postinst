#!/bin/bash

# Create Documents directory for logs
mkdir -p /var/mobile/Documents
chmod 755 /var/mobile/Documents
chown mobile:mobile /var/mobile/Documents

# Create default preferences
mkdir -p /var/mobile/Library/Preferences
chmod 755 /var/mobile/Library/Preferences
chown mobile:mobile /var/mobile/Library/Preferences

cat > /var/mobile/Library/Preferences/com.aosaid.naverseriesbypass.plist << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Enabled</key>
    <true/>
    <key>SpoofIDFV</key>
    <true/>
    <key>BlockKeychain</key>
    <true/>
    <key>SpoofHeaders</key>
    <true/>
    <key>JBBypass</key>
    <true/>
    <key>AutoDismissPopup</key>
    <true/>
    <key>NeutralizeResponses</key>
    <true/>
</dict>
</plist>
EOF

chmod 644 /var/mobile/Library/Preferences/com.aosaid.naverseriesbypass.plist
chown mobile:mobile /var/mobile/Library/Preferences/com.aosaid.naverseriesbypass.plist

echo "========================================"
echo "Naver Series Bypass v2.2.8 installed!"
echo "========================================"
echo ""
echo "Settings: Settings -> Naver Series Bypass"
echo "Logs: /var/mobile/Documents/NaverBypass_Diagnostics.log"
echo ""
echo "Features enabled by default:"
echo "  - IDFV Spoofing"
echo "  - Keychain Blocking"
echo "  - Header Spoofing"
echo "  - JB Detection Bypass"
echo ""
echo "Open Naver Series and tap on an episode."
echo "Check Settings for live stats and logs."
# Break Settings cache so the entry appears immediately
killall Preferences 2>/dev/null || true
# Stop a running target so the dynamic loader applies the new filter on next launch.
killall NaverBooks 2>/dev/null || true
killall NaverSeries 2>/dev/null || true

echo "========================================"

exit 0
